# ============================================================================
# Faux Spy Environment Variables
# Copy this file to .env.local for local development
# Set these same vars in Vercel dashboard for production
# ============================================================================

# Stripe API Keys (from https://dashboard.stripe.com/apikeys)
# Use sk_test_... for testing, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe Price IDs (create products in Stripe dashboard first)
# Format: price_xxxxxxxxxxxxx. A missing plan price makes that plan's
# checkout button fail; a missing top-up price disables that pack.
STRIPE_PRICE_MONTHLY=price_your_monthly_id                # Secret Agent, $9.99/mo
STRIPE_PRICE_YEARLY=price_your_yearly_id                  # Master Spy, $99/yr
STRIPE_VIDEO_MONTHLY_PRICE_ID=price_your_video_monthly_id # Pro + Video, $29.99/mo
STRIPE_VIDEO_YEARLY_PRICE_ID=price_your_video_yearly_id   # Pro + Video, $299/yr
STRIPE_PRICE_TOPUP_SMALL=price_your_topup_small_id        # 50 tokens, $1.99 (one-time)
STRIPE_PRICE_TOPUP_MEDIUM=price_your_topup_medium_id      # 200 tokens, $5.99 (one-time)
STRIPE_PRICE_TOPUP_LARGE=price_your_topup_large_id        # 500 tokens, $11.99 (one-time)

# Stripe Webhook Secret (get this AFTER creating webhook endpoint)
# Format: whsec_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Your site URL (no trailing slash)
SITE_URL=https://fauxspy.com

# ============================================================================
# OPTIONAL: Database (recommended for production)
# ============================================================================

# Supabase (https://supabase.com - free tier available)
# Used for the anonymized community detection history (see supabase/migrations/).
# Get these from Settings -> API in your Supabase project. Use the service_role
# key, never anon — RLS on community_detections has no public policies.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxx

# ============================================================================
# Email (license keys, top-up receipts, /account key recovery links)
# ============================================================================

# Resend (https://resend.com - 100 free emails/day). Required in production:
# without it buyers get no license email and /account can't send links.
RESEND_API_KEY=re_xxxxxxxxxx
# RESEND_FROM_EMAIL=Faux Spy <hello@fauxspy.com>

# ============================================================================
# IndexNow — Auto-notify search engines on deploy (Bing, Yandex, etc.)
# ============================================================================

# Key must match the filename at /a3f8b2e1d94c6071a5b8d23e1f406789.txt
# Also add this as a GitHub Actions secret (INDEXNOW_KEY) for auto-submission
INDEXNOW_KEY=a3f8b2e1d94c6071a5b8d23e1f406789

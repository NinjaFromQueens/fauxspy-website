{
  "id": "/check",
  "name": "Faux Spy: AI Photo Checker",
  "short_name": "Faux Spy",
  "description": "Check whether a photo is AI-generated. Upload a photo or share a screenshot and get a verdict in seconds.",
  "start_url": "/check?source=app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0e1a",
  "theme_color": "#0a0e1a",
  "categories": ["utilities", "security"],
  "icons": [
    { "src": "/app-icons/app-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app-icons/app-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app-icons/app-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "image", "accept": ["image/*"] }]
    }
  }
}
